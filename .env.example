# Asena settings
# Copy this file to .env and fill in your values:  cp .env.example .env
# Bun loads .env automatically.

# Your phone number(s): country code + number, no "+". Comma-separated for several.
# The owner can run every command and gets the system log group.
OWNER_NUMBER=2349112171078

# Extra trusted numbers that can run owner-level commands (comma-separated).
 SUDO=2349112171078

# Command prefix. Default "#", so commands look like "#menu".
# PREFIX=#

# First-start defaults. After the first start, use #mode and #lang instead.
BOT_MODE=private
BOT_LANG=en

# Where the WhatsApp login is stored: sqlite (default, ./data/session.db) | postgres | redis | mongodb
# AUTH_DB=sqlite
# AUTH_DB_URL=postgresql://user:pass@host:5432/asena   (or redis://host:6379/0, mongodb://host/asena)
# With AUTH_DB=postgres, bot settings go to Postgres too; otherwise they stay in ./data/bot.db.
# DATA_DIR=./data

# Session ID from https://asena.fun/pair. When set, the login and settings are stored on the
# Asena server, encrypted with this ID, and AUTH_DB is ignored. Run one copy at a time.
# SESSION_ID=
# ASENA_SERVER=https://api.asena.fun
# SESSION_SYNC_SECONDS=20

# Log in with an 8-character pairing code (in the terminal) instead of a QR code.
PAIRING_NUMBER=2349112171078

STICKER_PACKNAME=Asena§
STICKER_AUTHOR=Asena

# Optional remove.bg API key for #removebg
# REMOVEBG_API_KEY=

# Bot log level: error | warn | info | debug
LOG_LEVEL=info
# zapo (WhatsApp library) log level: trace | debug | info | warn | error
# "warn" shows harmless delivery notices (e.g. skipped stale linked devices); use it when debugging.
ZAPO_LOG_LEVEL=error

# How many heavy media jobs (YouTube etc.) run at the same time
JOB_CONCURRENCY=1
# Errors per minute before a warning goes to the log group
ERROR_ALERT_THRESHOLD=8

# Label used in metrics and backups
TENANT_ID=default

# Optional admin HTTP API (health, metrics, audit). Needs a token when enabled.
# ADMIN_HTTP_PORT=8787
# ADMIN_HTTP_HOST=127.0.0.1
# ADMIN_HTTP_TOKEN=change-me-to-a-long-secret
